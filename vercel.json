{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path((?!api(?:/|$)).*)",
      "has": [
        {
          "type": "host",
          "value": "hajidigital.vercel.app"
        }
      ],
      "destination": "https://hajji.digital/:path",
      "permanent": false
    },
    {
      "source": "/:path((?!api(?:/|$)).*)",
      "has": [
        {
          "type": "host",
          "value": "manasik-haji-rho.vercel.app"
        }
      ],
      "destination": "https://hajji.digital/:path",
      "permanent": false
    },
    {
      "source": "/:path((?!api(?:/|$)).*)",
      "has": [
        {
          "type": "host",
          "value": "www.hajji.digital"
        }
      ],
      "destination": "https://hajji.digital/:path",
      "permanent": false
    },
    {
      "source": "/:path((?!api(?:/|$)).*)",
      "has": [
        {
          "type": "host",
          "value": "manasik-haji-jualdigital.vercel.app"
        }
      ],
      "destination": "https://hajji.digital/:path",
      "permanent": false
    },
    {
      "source": "/:code((?!api$|assets$|public$|index$|checkout$|affiliate$|account$|admin$|studio$|peserta$|verify$|offline$|district$|manasik$|player$|sai$|umrah$|hajj$|explore$|legacy$|adventure$|adventure-map$|avatar-preview$|oleh-oleh$|certificate-admin$|voice-admin$|character-preview$|[a-z-]+-adventure$)[A-Za-z0-9][A-Za-z0-9-]{2,29})",
      "destination": "/index.html?ref=:code",
      "permanent": false
    }
  ]
}
